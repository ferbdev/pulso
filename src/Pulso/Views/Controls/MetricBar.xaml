<UserControl x:Class="Pulso.Views.Controls.MetricBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <StackPanel Margin="0,3">
        <DockPanel>
            <TextBlock DockPanel.Dock="Right"
                       Style="{StaticResource ValueText}"
                       Text="{Binding ValueText, ElementName=Root}" />
            <TextBlock Style="{StaticResource CaptionText}"
                       Text="{Binding Label, ElementName=Root}" />
        </DockPanel>
        <ProgressBar Margin="0,4,0,0"
                     Style="{StaticResource ThinBar}"
                     Maximum="100"
                     Value="{Binding Percent, ElementName=Root}"
                     Foreground="{Binding BarBrush, ElementName=Root}" />
    </StackPanel>
</UserControl>
